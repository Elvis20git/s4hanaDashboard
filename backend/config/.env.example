# AIF Analytics API — server-side only. NEVER expose to the browser, never commit the real file.
# Copy to backend/config/.env and fill in. The real .env is git-ignored.

# SAP S/4HANA (read-only OData). Credentials come from the environment/.env only.
SAP_HOST=https://<tenant>-api.s4hana.cloud.sap
SAP_USER=<communication user>
SAP_PASS=<communication password>

# Reporting scope
COMPANY_CODE=2000
SALES_ORG=2000
LEDGER=0L
PERIOD_FROM=2025-07-01
# Upper bound on BillingDocumentDate. Omit to run through today; set a date to cap the display window.
REPORT_TO=2026-09-30
OVERHEAD_GL=94301000
BATCH_CHUNK=50

# API port. The Vite dev server proxies /api here (see vite.config.js).
PORT=5180

# --- Test-only (parity harness). When set, the API loads this dataset instead of calling SAP, and serves
# --- batch/order drill-downs from captured snapshots in AIF_FIXTURE_DIR. Leave unset for normal operation.
# AIF_FIXTURE_DATASET=fixtures/dataset.json
# AIF_FIXTURE_DIR=fixtures

# --- Authentication (Django backend) --------------------------------------------------------------------------------------
# JWT_SECRET is REQUIRED when DJANGO_DEBUG=0 (use a long random string). In development a random one is generated into
# backend/.jwt_secret.local (git-ignored) so sessions survive restarts.
DJANGO_DEBUG=1
# JWT_SECRET=
# DJANGO_SECRET_KEY=            # required when DJANGO_DEBUG=0
SESSION_TTL_HOURS=8             # normal sign-in
SESSION_REMEMBER_DAYS=7         # "Remember this device"
APP_URL=http://localhost:5174   # used in password-reset links and as the allowed CORS origin
# CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# TRUST_PROXY=1                 # read X-Forwarded-For (rate limiting) when running behind a reverse proxy

# Email for password reset. Without SMTP_HOST the reset link is printed to the server console in development
# (and nothing is sent, with a warning logged, in production).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=1
# MAIL_FROM=AIF Analytics <no-reply@africaimprovedfoods.com>

# Bootstrap superuser: created by `manage.py seed_users` ONLY if no active SUPERUSER exists. Never hard-code credentials.
# ADMIN_USERNAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ALLOW_WEAK_SEED=true          # only to seed weak passwords (e.g. "123") when DJANGO_DEBUG=0
